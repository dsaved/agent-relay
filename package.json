{
  "name": "agent-relay",
  "version": "0.1.0",
  "description": "Phase 0 feasibility harness for relaying tasks between Codex/Claude desktop apps and CLIs under subscription auth.",
  "type": "module",
  "private": true,
  "bin": {
    "agent-relay": "dist/src/cli.js"
  },
  "exports": "./dist/src/cli.js",
  "files": [
    "dist/src"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint src test",
    "build": "tsc",
    "test": "npm run build && node --test 'dist/test/**/*.test.js'",
    "check": "npm run typecheck && npm run lint && npm run test"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^22.10.2",
    "eslint": "^9.17.0",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.1"
  }
}
